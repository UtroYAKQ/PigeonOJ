# ============================================================
# PigeonOJ 判题节点配置（复制为 .env.node 使用）
#   本地：run-local.bat 自动复制并以此启动 1 个默认节点容器
#   远程：整个仓库拷贝到目标服务器后，在仓库根目录执行：
#     docker compose --env-file .env.node --project-directory . -f docker/docker-compose-node.yml up -d --build
#   注意：--project-directory . 使 NODE_WORKSPACE_DIR / NODE_CACHE_DIR 相对路径基于仓库根解析
# ============================================================

# ---- 后端网关 ----
# 本机部署用 host.docker.internal（编排已注入 host-gateway，Linux 可用）；
# 经域名 443 走 TLS 时填 "www.example.com:443" 并设 SERVER_TLS=true
# （nginx 按服务路径 /pigeonoj.judge.v1.JudgeGateway/ grpc_pass 转发，见 docs/operations.md）。
SERVER_ADDRESS=host.docker.internal:50051
SERVER_TLS=false
# 注册令牌：必须与后端 JUDGE_GATEWAY_TOKENS 之一匹配
SERVER_TOKEN=dev-token

# ---- 节点身份（可留空自动生成 {hostname}-{pid}）----
JUDGE_NODE_ID=
JUDGE_NODE_NAME=

# ---- 并发容量 ----
JUDGE_NODE_CAPACITY=2

# ---- 数据缓存回收（LRU：超出上限按最近使用时间从旧到新删，判题中目录受保护）----
JUDGE_CACHE_MAX_MB=512                 # /cache 总大小上限；0 = 不限制不回收
JUDGE_CACHE_GC_INTERVAL_SECONDS=300    # 巡检间隔

# ---- 宿主机挂载目录（工作区即 nsjail 的 chroot 根；缓存按题目版本复用）----
# 相对路径基于仓库根解析；生产建议绝对路径
NODE_WORKSPACE_DIR=./.docker-data/node-work
NODE_CACHE_DIR=./.docker-data/node-cache
