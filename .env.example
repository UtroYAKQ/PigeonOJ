# 后端配置主文件是 src/backend/backend.toml；本文件仅用于覆盖（优先级高于 backend.toml）。
# 不需要覆盖的变量可注释掉或删除，保持留空即回落到 backend.toml。

# ============ 运行环境 ============
# ENVIRONMENT=development                # development / production
# SECRET_KEY=change-me-to-a-random-string # 会话 / 加密主密钥（生产环境必改）
# LOG_LEVEL=INFO

# ============ PostgreSQL ============
POSTGRES_USER=pigeonoj                  # docker compose 基础设施服务使用
POSTGRES_PASSWORD=pigeonoj              # docker compose 基础设施服务使用
POSTGRES_DB=pigeonoj                    # docker compose 基础设施服务使用
# DATABASE_URL=postgresql+asyncpg://pigeonoj:pigeonoj@localhost:5432/pigeonoj

# ============ Redis ============
# REDIS_URL=redis://localhost:6379/0

# ============ MinIO ============
MINIO_ENDPOINT=localhost:9000           # docker compose 基础设施服务读取 MINIO_ACCESS_KEY / MINIO_SECRET_KEY
# MINIO_ACCESS_KEY=pigeonoj
# MINIO_SECRET_KEY=pigeonoj-minio-secret
# MINIO_BUCKET=pigeonoj
# MINIO_SECURE=false                    # 生产（HTTPS）环境置 true

# ============ 前端 ============
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ============ 判题节点网关（gRPC :50051） ============
# 后端进程不执行任何用户代码；代码执行只发生在判题节点容器内。
# 注册令牌（逗号分隔多个）；为空则网关不启动。判题节点的 SERVER_TOKEN 需匹配其一。
# JUDGE_GATEWAY_TOKENS=dev-token
# JUDGE_GRPC_HOST=0.0.0.0
# JUDGE_GRPC_PORT=50051

# ============ 判题节点容器 ============
# 节点全部配置集中在 .env.node.example（含 chroot 工作区/缓存挂载目录、容量等）：
#   本地：run-local.bat 自动复制为 .env.node 并默认启动 1 个节点容器
#   远程：拷贝 src/judge 与 .env.node 到目标服务器，按文件内说明 compose 启动

# ============ 初始管理员（可选，部署后运行一次引导脚本）============
# 执行：docker exec <后端容器> sh -c "cd /app && python -m scripts.bootstrap_admin"
# 幂等：邮箱已存在则跳过（不覆盖密码）；两项均未设置时脚本静默跳过
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=            # 6~72 位，生产必填强密码
# BOOTSTRAP_ADMIN_NICKNAME=            # 可选，默认取邮箱前缀

# ============ 测试（可选，默认连 pigeonoj_test 库 / Redis db15）============
TEST_DATABASE_URL=postgresql+asyncpg://pigeonoj:pigeonoj@localhost:5432/pigeonoj_test
