# ============ 运行环境 ============
ENVIRONMENT=development                 # development / production
SECRET_KEY=change-me-to-a-random-string # 会话 / 加密主密钥（生产环境必改）
LOG_LEVEL=INFO

# ============ PostgreSQL ============
POSTGRES_USER=pigeonoj
POSTGRES_PASSWORD=pigeonoj
POSTGRES_DB=pigeonoj
DATABASE_URL=postgresql+asyncpg://pigeonoj:pigeonoj@localhost:5432/pigeonoj

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============ MinIO ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=pigeonoj
MINIO_SECRET_KEY=pigeonoj-minio-secret
MINIO_BUCKET=pigeonoj
MINIO_SECURE=false                       # 生产（HTTPS）环境置 true

# ============ 前端 ============
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ============ 大模型（LiteLLM）============
# 各 AI 能力（聊天 / 改码 / 编译纠错 / 出题）所用模型在 system_configs / model_configs 中配置，
# API Key 加密存储；此处仅放提供方级兜底 Key（可选），不配置则运行时读 model_configs。
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
